#include "..\Version.h"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

1 VERSIONINFO
 FILEVERSION LUCID_VERSION_RC
 PRODUCTVERSION LUCID_VERSION_RC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", LUCID_COMPANY_NAME
            VALUE "FileDescription", "Lucid Viewer WIC image loader"
            VALUE "FileVersion", LUCID_VERSION_STR
            VALUE "InternalName", "WICLoader"
            VALUE "LegalCopyright", "Copyright 2026 Cem Girgin. Based on JPEGView, 2006-2011 David Kleiner. GPL v2"
            VALUE "OriginalFilename", "WICLoader.dll"
            VALUE "ProductName", LUCID_PRODUCT_NAME
            VALUE "ProductVersion", LUCID_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

/////////////////////////////////////////////////////////////////////////////

